  m_EditorClassIdentifier:
  _Order: 5
  stepType: 5
  actorType: 1
  npcNickname: bspc
  textAlias: '洪门走夜路用的。多一道横杠，是叫后来的人绕行。'
  eventBgmName:
  efxSoundCue: {fileID: 0}
--- !u!114 &114900000000000007
