  m_Script: {fileID: 11500000, guid: 91e4df88670b8978c18bb89c853302d0, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  _Order: 4
  stepType: 5
  actorType: 0
  npcNickname:
  textAlias: '你怎么也跟来了？怕我找着老小，顺带把你的账也算了？'
  eventBgmName:
  efxSoundCue: {fileID: 0}
--- !u!114 &114900000000000005
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 100100000}
  m_GameObject: {fileID: 1709254077376921}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 91e4df88670b8978c18bb89c853302d0, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  _Order: 5
  stepType: 5
  actorType: 1
  npcNickname: BAEIDO
  textAlias: '我是来找零件的。那家伙砸碎了外壳，却挑走了最小的一根指针。'
  eventBgmName:
  efxSoundCue: {fileID: 0}
