  m_Name:
  m_EditorClassIdentifier:
  _Order: 9
  stepType: 5
  actorType: 0
  npcNickname:
  textAlias: '那他拿着指针进山……等等，有人踩着我们的脚印过来了。'
  eventBgmName:
  efxSoundCue: {fileID: 0}
--- !u!114 &114900000000000010
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 100100000}
  m_GameObject: {fileID: 1709254077376921}
