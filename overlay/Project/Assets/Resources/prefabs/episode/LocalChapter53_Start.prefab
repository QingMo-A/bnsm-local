  m_Name:
  m_EditorClassIdentifier:
  _Order: 7
  stepType: 5
  actorType: 2
  npcNickname: banji
  textAlias: '等一下。主人，这块碎片离山道越近，抖得越厉害。'
  eventBgmName:
  efxSoundCue: {fileID: 0}
--- !u!114 &114900000000000008
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 100100000}
  m_GameObject: {fileID: 1709254077376921}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 91e4df88670b8978c18bb89c853302d0, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  _Order: 8
  stepType: 5
  actorType: 1
  npcNickname: BAEIDO
  textAlias: '它本来就是追浊气用的。哪边浊气重，指针就往哪边转。'
  eventBgmName:
  efxSoundCue: {fileID: 0}
--- !u!114 &114900000000000009
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 100100000}
  m_GameObject: {fileID: 1709254077376921}
