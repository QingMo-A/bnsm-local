--- !u!114 &114900000000000003
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 100100000}
  m_GameObject: {fileID: 1709254077376921}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 91e4df88670b8978c18bb89c853302d0, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  _Order: 3
  stepType: 5
  actorType: 0
  npcNickname:
  textAlias: '人救出来了。他说车队前一站就是北渠，还见过押车的头领。'
  eventBgmName:
  efxSoundCue: {fileID: 0}
--- !u!114 &114900000000000004
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 100100000}
  m_GameObject: {fileID: 1709254077376921}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 91e4df88670b8978c18bb89c853302d0, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  _Order: 4
  stepType: 5
  actorType: 1
  npcNickname: bspc
  textAlias: '就是我在无日峰那晚见过的人。他知道从哪条道上山。'
  eventBgmName:
  efxSoundCue: {fileID: 0}
--- !u!114 &114900000000000005
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 100100000}
  m_GameObject: {fileID: 1709254077376921}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 91e4df88670b8978c18bb89c853302d0, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  _Order: 5
  stepType: 5
  actorType: 2
  npcNickname: banji
  textAlias: '主人，货单背后有三个存放法器的地方。最靠近咱们的是北渠。'
  eventBgmName:
  efxSoundCue: {fileID: 0}
--- !u!114 &114900000000000006
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 100100000}
  m_GameObject: {fileID: 1709254077376921}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 91e4df88670b8978c18bb89c853302d0, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  _Order: 6
  stepType: 5
  actorType: 0
  npcNickname:
  textAlias: '先把驿卒送到有人接应的地方。然后我们一起去北渠。'
  eventBgmName:
  efxSoundCue: {fileID: 0}
--- !u!114 &114900000000000007
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 100100000}
  m_GameObject: {fileID: 1709254077376921}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 91e4df88670b8978c18bb89c853302d0, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  _Order: 7
  stepType: 5
  actorType: 1
  npcNickname: bspc
  textAlias: '好。这回我在渡口等你。'
  eventBgmName:
  efxSoundCue: {fileID: 0}
