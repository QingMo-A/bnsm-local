<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Bnsm.LocalServer</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <!-- Keep the portable Windows host usable without CET shadow-stack opt-in. -->
    <CETCompat>false</CETCompat>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ServerCore/Bnsm.ServerCore.csproj" />
    <Compile Include="../LocalServer/DebugApi.cs" Link="DebugApi.cs" />
    <Compile Include="../LocalServer/GlobalUsings.cs" Link="GlobalUsings.cs" />
    <Reference Include="Assembly-CSharp"><HintPath>../build/Assembly-CSharp.dll</HintPath><Aliases>game</Aliases></Reference>
    <Reference Include="protobuf-net"><HintPath>../references/Managed/protobuf-net.dll</HintPath></Reference>
    <Reference Include="UnityEngine"><HintPath>../references/Managed/UnityEngine.dll</HintPath></Reference>
  </ItemGroup>
</Project>
